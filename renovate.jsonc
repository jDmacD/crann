{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  // nixpkgs tracks nixos-unstable (no rev in flake.nix), so Renovate can only
  // move it through lock file maintenance. The channel only advances after
  // Hydra builds it, so a weekly bump lands on a cached revision. Following
  // master instead gave several bumps a day, ahead of cache.nixos.org.
  // Every other input pins a rev in flake.nix, so this only moves nixpkgs.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"],
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      // SDK 2.x negotiates MCP revision 2026-07-28, which Claude Code won't
      // register as a channel. Bumps also need bun.nix regenerated
      // (bun install runs the postinstall), so they are never automerged.
      "matchFileNames": ["packages/claude-channel-grafana/**"],
      "matchPackageNames": ["@modelcontextprotocol/sdk"],
      "allowedVersions": "<2"
    }
  ]
}
